.agents*/
.claude*/

# Raw data: anchored to the repo root, so it never swallows src/dehyd/data/.
/data*/
logs*/
review*/
archive*/
matlab*/
paper*/

# A copied-tree revision stamp (git rev-parse HEAD > REVISION), read by provenance when
# there is no .git — e.g. IBEX, where the private repo is copied, not cloned. Never
# committed, so it can't dirty a real checkout.
/REVISION

.venv/
__pycache__/
.pytest_cache/
.cache/
*.egg-info/

# Per-run provenance/scratch records: regenerated by every invocation.
# Curated, reported artifacts still belong in results/ and are added deliberately.
results/runs/

# Transient WST job-array output: per-cell shards + fingerprint sidecars, merged into
# the committed curated CSV (results/wst/wst_diagnostics_77ghz.csv). Regenerable.
results/wst/shards/

# The milestone-7 per-session feature store (npz + fingerprint sidecars). Large and fully
# regenerable from a clean commit by experiments/extract_features.py; never committed.
results/features/
