# sbatch scripts are developed on Windows but run on Linux; a CRLF line ending breaks the
# shebang (`/bin/bash^M: bad interpreter`). Force LF on checkout for the IBEX scripts.
scripts/ibex/* text eol=lf

# The milestone-7 Exp A reference artifacts exist to be compared BYTE-FOR-BYTE: O-M9-5 sha256s
# predictions_{band}.csv and selection_table_{band}.csv against every later Exp A re-run. This
# machine has core.autocrlf=true, so without `-text` git would normalise these CSVs on checkout,
# the working-tree bytes would differ from the M7 originals, and the gate would fail against its
# own reference. Marking them binary is what makes committing them safe.
results/runs/*_f36c4fb2/** -text

# The milestone-10 reference gate's immutable evidence. Same reasoning as the M7 artifacts
# above, with one difference that makes it stronger: this file is NOT regenerable at all
# after M10 rebuilds the stores, because the branch-aware feature evidence it records (stored
# session vectors, raw pre-log tensors, the fold-local tuned epsilon) belongs to a store that
# will no longer exist. `--compare` reads it as JSON, so EOL conversion would not break the
# gate — but it is evidence, and evidence whose bytes change on checkout is worth less.
results/milestone10/*.json -text
